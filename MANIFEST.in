include README.md LICENSE CHANGELOG.md CONTRIBUTING.md CODE_OF_CONDUCT.md pyproject.toml
recursive-include src *.py
recursive-include src *.typed
recursive-include tests *.py
recursive-include examples *.py
recursive-include examples *.csv
recursive-include docs *.md
recursive-include benchmarks *.py
recursive-include benchmarks *.md
recursive-include benchmarks *.json
recursive-include .github *.yml
recursive-include scripts *.py
prune .venv
prune .venv-install-test
prune .venv-py312
prune .venv-py310
prune dist
prune build
global-exclude __pycache__
global-exclude *.py[cod]
